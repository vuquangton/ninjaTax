@model ninjaTax.Models.Entities.HoaDonBanHang
@{
    ViewData["Title"] = $"Chi tiết Hóa đơn bán {Model.SoChungTu}";
}

<div class="container-fluid py-3">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <div class="d-flex align-items-center gap-2">
                <h3 class="mb-0 text-primary"><i class="bi bi-receipt-cutoff me-2"></i>Hóa Đơn Bán Hàng: @Model.SoChungTu</h3>
                @switch (Model.TrangThai)
                {
                    case ninjaTax.Models.Entities.TrangThaiHddt.MoiTao:
                        <span class="badge bg-secondary">Mới tạo</span>
                        break;
                    case ninjaTax.Models.Entities.TrangThaiHddt.CoQuanThueCapMa:
                        <span class="badge bg-success"><i class="bi bi-shield-check me-1"></i>HĐĐT Hợp lệ (Đã cấp mã CQT)</span>
                        break;
                    case ninjaTax.Models.Entities.TrangThaiHddt.DaHuy:
                        <span class="badge bg-danger"><i class="bi bi-x-circle me-1"></i>Đã hủy</span>
                        break;
                    default:
                        <span class="badge bg-info">@Model.TrangThai</span>
                        break;
                }
                @if (Model.DaGhiSo)
                {
                    <span class="badge bg-primary"><i class="bi bi-journal-check me-1"></i>Đã ghi sổ kế toán kép</span>
                }
            </div>
            <small class="text-muted">
                Ký hiệu: <strong>@Model.KHMauSo@Model.KyHieu</strong> | Số HĐĐT: <strong class="text-primary font-monospace">@(Model.SoHoaDon ?? "Chưa cấp")</strong> | Ngày lập: @Model.NgayHoaDon.ToString("dd/MM/yyyy")
            </small>
        </div>
        <div class="d-flex gap-2">
            @if (Model.TrangThai == ninjaTax.Models.Entities.TrangThaiHddt.MoiTao)
            {
                <form asp-action="PhatHanhHddt" asp-route-id="@Model.Id" method="post">
                    <button type="submit" class="btn btn-outline-primary">
                        <i class="bi bi-send-check me-1"></i>Phát Hành HĐĐT (Cấp mã CQT)
                    </button>
                </form>
            }

            @if (!Model.DaGhiSo && Model.TrangThai != ninjaTax.Models.Entities.TrangThaiHddt.DaHuy)
            {
                <form asp-action="GhiSo" asp-route-id="@Model.Id" method="post">
                    <button type="submit" class="btn btn-success">
                        <i class="bi bi-journal-arrow-down me-1"></i>Ghi Sổ Kế Toán (TT99)
                    </button>
                </form>
            }
            else if (Model.DaGhiSo)
            {
                <form asp-action="BoGhiSo" asp-route-id="@Model.Id" method="post">
                    <button type="submit" class="btn btn-outline-warning">
                        <i class="bi bi-journal-x me-1"></i>Bỏ Ghi Sổ
                    </button>
                </form>
                @if (Model.ButToanDoanhThuId.HasValue)
                {
                    <a asp-controller="ButToan" asp-action="Details" asp-route-id="@Model.ButToanDoanhThuId.Value" class="btn btn-outline-info">
                        <i class="bi bi-box-arrow-up-right me-1"></i>BT Doanh Thu
                    </a>
                }
                @if (Model.ButToanGiaVonId.HasValue)
                {
                    <a asp-controller="ButToan" asp-action="Details" asp-route-id="@Model.ButToanGiaVonId.Value" class="btn btn-outline-dark">
                        <i class="bi bi-box-arrow-up-right me-1"></i>BT Giá Vốn
                    </a>
                }
            }

            <a asp-action="Index" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left me-1"></i>Danh sách
            </a>
        </div>
    </div>

    @if (TempData["ThongBaoThanhCong"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>@TempData["ThongBaoThanhCong"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["ThongBaoLoi"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["ThongBaoLoi"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Header information -->
    <div class="row g-3 mb-4">
        <div class="col-md-8">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-header bg-light fw-bold text-dark">
                    <i class="bi bi-person-badge me-1"></i>Thông tin Khách hàng & Cơ quan Thuế
                </div>
                <div class="card-body">
                    <div class="row g-2">
                        <div class="col-sm-4 text-muted">Khách hàng:</div>
                        <div class="col-sm-8 fw-semibold">@Model.KhachHang?.TenDoiTuong</div>

                        <div class="col-sm-4 text-muted">Mã số thuế:</div>
                        <div class="col-sm-8 font-monospace">@(Model.KhachHang?.MaSoThue ?? "Không có")</div>

                        <div class="col-sm-4 text-muted">Địa chỉ:</div>
                        <div class="col-sm-8">@(Model.KhachHang?.DiaChi ?? "Không có")</div>

                        <div class="col-sm-4 text-muted">Diễn giải:</div>
                        <div class="col-sm-8">@Model.DienGiai</div>

                        @if (!string.IsNullOrEmpty(Model.MaCoQuanThue))
                        {
                            <div class="col-sm-4 text-muted">Mã CQT cấp:</div>
                            <div class="col-sm-8 font-monospace text-primary fw-bold">@Model.MaCoQuanThue</div>
                        }

                        @if (!string.IsNullOrEmpty(Model.ChuKySo))
                        {
                            <div class="col-sm-4 text-muted">Chữ ký số:</div>
                            <div class="col-sm-8 font-monospace small text-truncate">@Model.ChuKySo</div>
                        }
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-header bg-light fw-bold text-dark">
                    <i class="bi bi-calculator me-1"></i>Tổng thanh toán & Công nợ
                </div>
                <div class="card-body">
                    <div class="d-flex justify-content-between mb-2">
                        <span class="text-muted">Tổng tiền hàng:</span>
                        <span class="font-monospace fw-bold">@Model.TongTienHang.ToString("N0") đ</span>
                    </div>
                    <div class="d-flex justify-content-between mb-2">
                        <span class="text-muted">Chiết khấu thương mại:</span>
                        <span class="font-monospace text-danger">-@Model.TongTienChietKhau.ToString("N0") đ</span>
                    </div>
                    <div class="d-flex justify-content-between mb-2">
                        <span class="text-muted">Thuế GTGT (33311):</span>
                        <span class="font-monospace text-primary">+@Model.TongTienThue.ToString("N0") đ</span>
                    </div>
                    <hr />
                    <div class="d-flex justify-content-between mb-2">
                        <span class="fw-bold">Tổng thanh toán:</span>
                        <span class="font-monospace fw-bold text-success fs-5">@Model.TongThanhToan.ToString("N0") đ</span>
                    </div>
                    <div class="d-flex justify-content-between">
                        <span class="text-muted">Còn phải thu (131):</span>
                        <span class="font-monospace fw-bold text-danger">@Model.ConPhaiThu.ToString("N0") đ</span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Items table -->
    <div class="card shadow-sm border-0">
        <div class="card-header bg-light fw-bold text-dark">
            <i class="bi bi-list-ul me-1"></i>Chi tiết mặt hàng bán & Hạch toán kép TT99
        </div>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-3" style="width: 40px;">#</th>
                        <th>Mặt hàng</th>
                        <th class="text-end">Số lượng</th>
                        <th class="text-end">Đơn giá bán</th>
                        <th class="text-end">Thành tiền</th>
                        <th class="text-end">CK</th>
                        <th class="text-end">VAT</th>
                        <th class="text-end">Tiền thuế</th>
                        <th class="text-end">Đơn giá vốn</th>
                        <th class="text-end">Tổng giá vốn</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var c in Model.ChiTietBans)
                    {
                        <tr>
                            <td class="ps-3">@c.DongSo</td>
                            <td>
                                <div class="fw-bold">@c.VatTuHangHoa?.TenVatTu</div>
                                <small class="text-muted font-monospace">@c.VatTuHangHoa?.MaVatTu (@c.VatTuHangHoa?.DonViTinh)</small>
                            </td>
                            <td class="text-end font-monospace">@c.SoLuong.ToString("N2")</td>
                            <td class="text-end font-monospace">@c.DonGia.ToString("N0") đ</td>
                            <td class="text-end font-monospace fw-semibold">@c.ThanhTien.ToString("N0") đ</td>
                            <td class="text-end font-monospace">@c.TienChietKhau.ToString("N0") đ</td>
                            <td class="text-end">@c.ThueSuatVat%</td>
                            <td class="text-end font-monospace text-primary">@c.TienThueVat.ToString("N0") đ</td>
                            <td class="text-end font-monospace text-muted">@c.DonGiaVon.ToString("N0") đ</td>
                            <td class="text-end font-monospace fw-semibold text-secondary">@((c.SoLuong * c.DonGiaVon).ToString("N0")) đ</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
