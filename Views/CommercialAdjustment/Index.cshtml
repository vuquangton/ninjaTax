@model List<ninjaTax.Models.Entities.ChungTuDieuChinhThuongMai>
@{
    ViewData["Title"] = "Điều chỉnh thương mại";
    var currentLoai = ViewBag.CurrentLoai as ninjaTax.Models.Entities.LoaiDieuChinhThuongMai?;
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 mb-1 text-gray-800"><i class="bi bi-receipt-cutoff me-2 text-primary"></i>Điều chỉnh thương mại</h1>
            <p class="text-muted small mb-0">Hàng bán bị trả lại (5212), Hàng mua trả lại, Chiết khấu thương mại (5211), Giảm giá hàng bán</p>
        </div>
        <div class="dropdown">
            <button class="btn btn-primary dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                <i class="bi bi-plus-circle me-1"></i>Lập chứng từ điều chỉnh
            </button>
            <ul class="dropdown-menu dropdown-menu-end shadow">
                <li><a class="dropdown-item" asp-action="Create" asp-route-loai="1"><i class="bi bi-arrow-return-left me-2 text-danger"></i>Hàng bán bị trả lại (TK 5212)</a></li>
                <li><a class="dropdown-item" asp-action="Create" asp-route-loai="2"><i class="bi bi-arrow-return-right me-2 text-warning"></i>Hàng mua trả lại (Có TK 1561)</a></li>
                <li><a class="dropdown-item" asp-action="Create" asp-route-loai="3"><i class="bi bi-percent me-2 text-info"></i>Chiết khấu thương mại (TK 5211)</a></li>
                <li><a class="dropdown-item" asp-action="Create" asp-route-loai="4"><i class="bi bi-tag me-2 text-success"></i>Giảm giá hàng mua</a></li>
            </ul>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle me-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle me-2"></i>@TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="card shadow mb-4">
        <div class="card-header py-3 bg-white d-flex justify-content-between align-items-center">
            <h6 class="m-0 font-weight-bold text-primary">Danh sách chứng từ điều chỉnh</h6>
            <div class="btn-group btn-group-sm" role="group">
                <a asp-action="Index" class="btn @(currentLoai == null ? "btn-primary" : "btn-outline-secondary")">Tất cả</a>
                <a asp-action="Index" asp-route-loai="1" class="btn @(currentLoai == ninjaTax.Models.Entities.LoaiDieuChinhThuongMai.HangBanTraLai ? "btn-primary" : "btn-outline-secondary")">Hàng bán trả lại</a>
                <a asp-action="Index" asp-route-loai="2" class="btn @(currentLoai == ninjaTax.Models.Entities.LoaiDieuChinhThuongMai.HangMuaTraLai ? "btn-primary" : "btn-outline-secondary")">Hàng mua trả lại</a>
                <a asp-action="Index" asp-route-loai="3" class="btn @(currentLoai == ninjaTax.Models.Entities.LoaiDieuChinhThuongMai.ChietKhauThuongMaiBan ? "btn-primary" : "btn-outline-secondary")">Chiết khấu thương mại</a>
            </div>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Số chứng từ</th>
                            <th>Loại điều chỉnh</th>
                            <th>Ngày hạch toán</th>
                            <th>Đối tượng</th>
                            <th class="text-end">Tiền hàng</th>
                            <th class="text-end">Thuế GTGT</th>
                            <th class="text-end">Tổng thanh toán</th>
                            <th>Trạng thái</th>
                            <th class="text-center">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="9" class="text-center py-4 text-muted">
                                    <i class="bi bi-inbox fs-2 d-block mb-2"></i>
                                    Chưa có chứng từ điều chỉnh thương mại nào.
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td class="fw-bold">
                                        <a asp-action="Details" asp-route-id="@item.Id">@item.SoChungTu</a>
                                    </td>
                                    <td>
                                        @if (item.LoaiDieuChinh == ninjaTax.Models.Entities.LoaiDieuChinhThuongMai.HangBanTraLai)
                                        {
                                            <span class="badge bg-danger">Hàng bán trả lại</span>
                                        }
                                        else if (item.LoaiDieuChinh == ninjaTax.Models.Entities.LoaiDieuChinhThuongMai.HangMuaTraLai)
                                        {
                                            <span class="badge bg-warning text-dark">Hàng mua trả lại</span>
                                        }
                                        else if (item.LoaiDieuChinh == ninjaTax.Models.Entities.LoaiDieuChinhThuongMai.ChietKhauThuongMaiBan)
                                        {
                                            <span class="badge bg-info text-dark">Chiết khấu thương mại</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">Giảm giá hàng mua</span>
                                        }
                                    </td>
                                    <td>@item.NgayHachToan.ToString("dd/MM/yyyy")</td>
                                    <td>@item.DoiTuong?.TenDoiTuong</td>
                                    <td class="text-end fw-semibold">@item.TongTienHang.ToString("N0") đ</td>
                                    <td class="text-end text-muted">@item.TongTienThueVat.ToString("N0") đ</td>
                                    <td class="text-end fw-bold text-primary">@item.TongThanhToan.ToString("N0") đ</td>
                                    <td>
                                        @if (item.TrangThai == ninjaTax.Models.Entities.TrangThaiDieuChinhThuongMai.DaGhiSo)
                                        {
                                            <span class="badge bg-success">Đã ghi sổ</span>
                                        }
                                        else if (item.TrangThai == ninjaTax.Models.Entities.TrangThaiDieuChinhThuongMai.DaHuy)
                                        {
                                            <span class="badge bg-danger">Đã hủy</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">Tạm tính</span>
                                        }
                                    </td>
                                    <td class="text-center">
                                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-info me-1" title="Chi tiết">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                        @if (item.TrangThai != ninjaTax.Models.Entities.TrangThaiDieuChinhThuongMai.DaHuy)
                                        {
                                            <form asp-action="Cancel" asp-route-id="@item.Id" method="post" class="d-inline" onsubmit="return confirm('Bạn có chắc muốn hủy chứng từ này?');">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-sm btn-outline-danger" title="Hủy">
                                                    <i class="bi bi-x-circle"></i>
                                                </button>
                                            </form>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
