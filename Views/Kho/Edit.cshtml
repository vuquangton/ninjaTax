@model ninjaTax.Models.ViewModels.KhoCreateEditViewModel
@{
    ViewData["Title"] = $"Chỉnh sửa kho: {Model.MaKho}";
}

<div class="container-fluid py-3">
    <div class="d-flex align-items-center mb-3">
        <a asp-action="Index" class="btn btn-outline-secondary me-3">
            <i class="bi bi-arrow-left"></i> Quay lại
        </a>
        <h3 class="mb-0 text-primary">
            <i class="bi bi-pencil-square me-2"></i>@ViewData["Title"]
        </h3>
    </div>

    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card shadow-sm border-0">
                <div class="card-body p-4">
                    <form method="post" asp-action="Edit" asp-route-id="@Model.Id">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="Id" />
                        <input type="hidden" asp-for="DaPhatSinhPhieuKho" />

                        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                        <div class="row g-3">
                            <div class="col-md-6">
                                <label asp-for="ChiNhanhId" class="form-label fw-semibold"></label> <span class="text-danger">*</span>
                                <select asp-for="ChiNhanhId" asp-items="Model.BranchList" class="form-select"></select>
                                <span asp-validation-for="ChiNhanhId" class="text-danger"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="MaKho" class="form-label fw-semibold"></label> <span class="text-danger">*</span>
                                @if (Model.DaPhatSinhPhieuKho)
                                {
                                    <input asp-for="MaKho" class="form-control font-monospace text-uppercase" readonly />
                                    <small class="text-muted"><i class="bi bi-lock-fill"></i> Đã phát sinh phiếu kho, không thể đổi mã</small>
                                }
                                else
                                {
                                    <input asp-for="MaKho" class="form-control font-monospace text-uppercase" />
                                }
                                <span asp-validation-for="MaKho" class="text-danger"></span>
                            </div>

                            <div class="col-md-8">
                                <label asp-for="TenKho" class="form-label fw-semibold"></label> <span class="text-danger">*</span>
                                <input asp-for="TenKho" class="form-control" />
                                <span asp-validation-for="TenKho" class="text-danger"></span>
                            </div>

                            <div class="col-md-4 d-flex align-items-center mt-4">
                                <div class="form-check form-switch">
                                    <input asp-for="DangHoatDong" class="form-check-input" type="checkbox" id="dangHoatDongSwitch" />
                                    <label class="form-check-label fw-semibold" for="dangHoatDongSwitch">Đang hoạt động</label>
                                </div>
                            </div>

                            <div class="col-12">
                                <label asp-for="DiaChi" class="form-label fw-semibold"></label>
                                <input asp-for="DiaChi" class="form-control" />
                                <span asp-validation-for="DiaChi" class="text-danger"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="ThuKhoId" class="form-label fw-semibold"></label>
                                <select asp-for="ThuKhoId" asp-items="Model.EmployeeList" class="form-select"></select>
                                <span asp-validation-for="ThuKhoId" class="text-danger"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="TaiKhoanKhoMacDinhId" class="form-label fw-semibold"></label>
                                <select asp-for="TaiKhoanKhoMacDinhId" asp-items="Model.AccountList" class="form-select"></select>
                                <span asp-validation-for="TaiKhoanKhoMacDinhId" class="text-danger"></span>
                            </div>

                            <div class="col-12">
                                <label asp-for="GhiChu" class="form-label fw-semibold"></label>
                                <textarea asp-for="GhiChu" class="form-control" rows="2"></textarea>
                                <span asp-validation-for="GhiChu" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="d-flex justify-content-end gap-2 mt-4 pt-3 border-top">
                            <a asp-action="Index" class="btn btn-outline-secondary">Hủy bỏ</a>
                            <button type="submit" class="btn btn-primary px-4">
                                <i class="bi bi-check-circle me-1"></i>Cập nhật kho hàng
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
