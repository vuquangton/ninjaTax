@model ninjaTax.Models.ViewModels.KhoIndexViewModel
@{
    ViewData["Title"] = "Danh mục Kho hàng";
}

<div class="container-fluid py-3">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h3 class="mb-0 text-primary"><i class="bi bi-buildings me-2"></i>Danh mục Kho hàng</h3>
            <small class="text-muted">Quản lý các địa điểm lưu kho vật tư, thành phẩm, hàng hóa theo chi nhánh</small>
        </div>
        <a asp-action="Create" asp-route-branchId="@Model.BranchId" class="btn btn-primary">
            <i class="bi bi-plus-circle me-1"></i>Thêm Kho Mới
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="card shadow-sm border-0 mb-3">
        <div class="card-body">
            <form method="get" class="row g-2 align-items-center">
                <div class="col-md-4">
                    <label class="form-label small text-muted mb-1">Chi nhánh trực thuộc:</label>
                    <select name="branchId" asp-items="Model.BranchList" class="form-select">
                        <option value="">-- Tất cả chi nhánh --</option>
                    </select>
                </div>
                <div class="col-md-2 d-flex align-items-end">
                    <button type="submit" class="btn btn-secondary w-100">
                        <i class="bi bi-funnel me-1"></i>Lọc
                    </button>
                </div>
            </form>
        </div>
    </div>

    <div class="card shadow-sm border-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-3">Mã kho</th>
                        <th>Tên kho hàng</th>
                        <th>Chi nhánh</th>
                        <th>Địa chỉ</th>
                        <th>Thủ kho</th>
                        <th>TK Kho mặc định</th>
                        <th class="text-center">Trạng thái</th>
                        <th class="text-end pe-3">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Warehouses.Any())
                    {
                        <tr>
                            <td colspan="8" class="text-center py-4 text-muted">
                                <i class="bi bi-inbox fs-3 d-block mb-2"></i>Chưa có kho hàng nào được khai báo.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var item in Model.Warehouses)
                        {
                            <tr>
                                <td class="ps-3 font-monospace fw-bold text-primary">@item.MaKho</td>
                                <td>
                                    <div class="fw-semibold">@item.TenKho</div>
                                </td>
                                <td>@item.TenChiNhanh</td>
                                <td class="text-truncate" style="max-width: 250px;">@(item.DiaChi ?? "-")</td>
                                <td>@(item.TenThuKho ?? "-")</td>
                                <td class="font-monospace text-success fw-bold">@(item.TaiKhoanKhoMa ?? "-")</td>
                                <td class="text-center">
                                    @if (item.DangHoatDong)
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success-subtle">Hoạt động</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger-subtle text-danger border border-danger-subtle">Ngừng</span>
                                    }
                                </td>
                                <td class="text-end pe-3">
                                    <div class="btn-group btn-group-sm">
                                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-outline-secondary" title="Sửa">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        @if (!item.DaPhatSinhPhieuKho)
                                        {
                                            <button type="button" class="btn btn-outline-danger" title="Xóa"
                                                    onclick="xacNhanXoa(@item.Id, '@item.MaKho')">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<form id="deleteForm" method="post" asp-action="Delete">
    @Html.AntiForgeryToken()
</form>

@section Scripts {
<script>
    function xacNhanXoa(id, ma) {
        if (confirm(`Bạn có chắc chắn muốn xóa kho [${ma}] không?`)) {
            const form = document.getElementById('deleteForm');
            form.action = '@Url.Action("Delete", "Kho")/' + id;
            form.submit();
        }
    }
</script>
}
