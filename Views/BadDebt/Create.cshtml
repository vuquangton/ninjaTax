@model List<ninjaTax.Models.Services.ChiTietTrichLapDuPhongViewModel>
@{
    ViewData["Title"] = "Lập Bảng Dự Phòng Nợ Khó Đòi TT48";
    var ngayHachToan = (DateTime)ViewBag.NgayHachToan;
    var soDu2293 = (decimal)ViewBag.SoDu2293;
    var tongNoQuaHan = Model.Sum(x => x.SoTienConNo);
    var tongDuPhong = Model.Sum(x => x.SoTienDuPhong);
    var trichThem = tongDuPhong > soDu2293 ? tongDuPhong - soDu2293 : 0m;
    var hoanNhap = tongDuPhong < soDu2293 ? soDu2293 - tongDuPhong : 0m;
}

<div class="container-fluid py-3">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h3 class="mb-0 text-primary"><i class="bi bi-file-earmark-medical me-2"></i>Lập Bảng Trích Lập Dự Phòng Nợ Phải Thu Khó Đòi</h3>
            <small class="text-muted">Áp dụng khung trích lập 30%, 50%, 70%, 100% theo Thông tư 48/2019/TT-BTC</small>
        </div>
        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i>Quay lại danh sách
        </a>
    </div>

    <!-- Filter & summary card -->
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-body">
            <form method="get" class="row g-3 align-items-end mb-3">
                <div class="col-md-3">
                    <label class="form-label fw-semibold">Ngày hạch toán trích lập:</label>
                    <input type="date" name="ngayHachToan" value="@ngayHachToan.ToString("yyyy-MM-dd")" class="form-control" />
                </div>
                <div class="col-md-2">
                    <button type="submit" class="btn btn-outline-primary w-100">
                        <i class="bi bi-calculator me-1"></i>Tính lại
                    </button>
                </div>
            </form>

            <div class="row g-3">
                <div class="col-md-3">
                    <div class="p-3 bg-light rounded">
                        <div class="text-muted small">Tổng nợ quá hạn (&ge; 6 tháng)</div>
                        <div class="fs-4 fw-bold text-dark">@tongNoQuaHan.ToString("N0") đ</div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="p-3 bg-light rounded">
                        <div class="text-muted small">Mức dự phòng cần trích (TT48)</div>
                        <div class="fs-4 fw-bold text-primary">@tongDuPhong.ToString("N0") đ</div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="p-3 bg-light rounded">
                        <div class="text-muted small">Số dư Có TK 2293 hiện tại</div>
                        <div class="fs-4 fw-bold text-secondary">@soDu2293.ToString("N0") đ</div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="p-3 bg-light rounded">
                        @if (trichThem > 0)
                        {
                            <div class="text-danger small fw-bold">Trích bổ sung (Nợ 6426 / Có 2293)</div>
                            <div class="fs-4 fw-bold text-danger">+@trichThem.ToString("N0") đ</div>
                        }
                        else if (hoanNhap > 0)
                        {
                            <div class="text-success small fw-bold">Hoàn nhập dự phòng (Nợ 2293 / Có 6426)</div>
                            <div class="fs-4 fw-bold text-success">-@hoanNhap.ToString("N0") đ</div>
                        }
                        else
                        {
                            <div class="text-muted small">Chênh lệch dự phòng</div>
                            <div class="fs-4 fw-bold text-muted">0 đ</div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Details Table -->
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-header bg-light">
            <span class="fw-bold"><i class="bi bi-list-check me-2"></i>Danh Sách Khoản Nợ Quá Hạn Phải Trích Lập Dự Phòng (Từ 180 ngày trở lên)</span>
        </div>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light small">
                    <tr>
                        <th class="ps-3">Mã KH</th>
                        <th>Tên khách hàng</th>
                        <th>Số hóa đơn</th>
                        <th>Hạn thanh toán</th>
                        <th class="text-end">Số tiền còn nợ</th>
                        <th class="text-center">Số ngày quá hạn</th>
                        <th class="text-center">Tỷ lệ trích lập</th>
                        <th class="text-end pe-3 fw-bold">Mức dự phòng</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="8" class="text-center py-4 text-muted">Không có khoản nợ phải thu nào quá hạn từ 6 tháng (180 ngày) trở lên để trích lập.</td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var r in Model)
                        {
                            <tr>
                                <td class="ps-3 font-monospace fw-bold">@r.MaKhachHang</td>
                                <td>@r.TenKhachHang</td>
                                <td class="font-monospace">@r.SoHoaDon</td>
                                <td>@r.HanThanhToan.ToString("dd/MM/yyyy")</td>
                                <td class="text-end font-monospace">@r.SoTienConNo.ToString("N0") đ</td>
                                <td class="text-center font-monospace text-warning-emphasis">@r.SoNgayQuaHan ngày</td>
                                <td class="text-center">
                                    <span class="badge @(r.TyLeTrichLap == 100 ? "bg-danger" : r.TyLeTrichLap >= 70 ? "bg-warning text-dark" : "bg-info text-dark")">
                                        @r.TyLeTrichLap%
                                    </span>
                                </td>
                                <td class="text-end pe-3 font-monospace fw-bold text-primary">@r.SoTienDuPhong.ToString("N0") đ</td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
        <div class="card-footer bg-white text-end py-3">
            <form asp-action="Create" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="ngayHachToan" value="@ngayHachToan.ToString("yyyy-MM-dd")" />
                <input type="hidden" name="ghiChu" value="Trích lập dự phòng nợ phải thu khó đòi TT48 ngày @ngayHachToan.ToString("dd/MM/yyyy")" />
                <button type="submit" class="btn btn-success px-4" @(Model.Count == 0 && soDu2293 == 0 ? "disabled" : "")>
                    <i class="bi bi-journal-check me-1"></i>Lưu & Ghi Sổ Kế Toán Bảng Trích Lập
                </button>
            </form>
        </div>
    </div>
</div>
