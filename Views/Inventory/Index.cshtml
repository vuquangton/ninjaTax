@model ninjaTax.Models.ViewModels.InventoryIndexViewModel
@{
    ViewData["Title"] = "Quản Lý Kho & Hàng Tồn Kho (TT99 / VAS 02)";
}

<div class="container-fluid py-3">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h2 class="h3 mb-0 text-gray-800">
                <i class="bi bi-boxes text-primary me-2"></i>Quản Lý Kho & Hàng Tồn Kho
            </h2>
            <small class="text-muted">Theo dõi Nhập - Xuất - Tồn và Giá vốn hàng tồn kho chuẩn VAS 02 & Thông tư 99/2025/TT-BTC</small>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="CreateInward" class="btn btn-success btn-sm">
                <i class="bi bi-box-arrow-in-down me-1"></i>Lập Phiếu Nhập Kho
            </a>
            <a asp-action="CreateOutward" class="btn btn-primary btn-sm">
                <i class="bi bi-box-arrow-up-right me-1"></i>Lập Phiếu Xuất Kho
            </a>
            <a asp-action="BaoCaoNhapXuatTon" class="btn btn-outline-secondary btn-sm">
                <i class="bi bi-file-earmark-spreadsheet me-1"></i>Báo Cáo NXT (S10-DN)
            </a>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle me-1"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle me-1"></i>@TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- KPI Thống kê -->
    <div class="row g-3 mb-3">
        <div class="col-md-6">
            <div class="card border-0 shadow-sm border-start border-success border-4 h-100 py-2">
                <div class="card-body">
                    <div class="row align-items-center">
                        <div class="col">
                            <div class="text-xs fw-bold text-success text-uppercase mb-1">Tổng Tiền Hàng Nhập Kho</div>
                            <div class="h5 mb-0 fw-bold text-gray-800">@Model.TongTienNhap.ToString("N0") đ</div>
                            <small class="text-muted">Số phiếu nhập: @Model.InwardVouchers.Count</small>
                        </div>
                        <div class="col-auto">
                            <i class="bi bi-box-arrow-in-down fs-2 text-gray-300"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card border-0 shadow-sm border-start border-primary border-4 h-100 py-2">
                <div class="card-body">
                    <div class="row align-items-center">
                        <div class="col">
                            <div class="text-xs fw-bold text-primary text-uppercase mb-1">Tổng Giá Vốn Xuất Kho</div>
                            <div class="h5 mb-0 fw-bold text-gray-800">@Model.TongTienXuatGiaVon.ToString("N0") đ</div>
                            <small class="text-muted">Số phiếu xuất: @Model.OutwardVouchers.Count</small>
                        </div>
                        <div class="col-auto">
                            <i class="bi bi-box-arrow-up-right fs-2 text-gray-300"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Bộ Lọc -->
    <div class="card shadow-sm border-0 mb-3">
        <div class="card-body p-3">
            <form method="get" class="row g-2 align-items-end">
                <div class="col-md-3">
                    <label class="form-label small fw-semibold">Chi nhánh</label>
                    <select name="branchId" class="form-select form-select-sm" asp-items="Model.BranchList">
                        <option value="">-- Tất cả chi nhánh --</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label small fw-semibold">Kho hàng</label>
                    <select name="khoId" class="form-select form-select-sm" asp-items="Model.WarehouseList">
                        <option value="">-- Tất cả kho --</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label small fw-semibold">Loại chứng từ</label>
                    <select name="loaiPhieu" class="form-select form-select-sm">
                        <option value="" selected="@(!Model.SelectedLoaiPhieu.HasValue)">Tất cả phiếu</option>
                        <option value="1" selected="@(Model.SelectedLoaiPhieu == 1)">Phiếu Nhập Kho</option>
                        <option value="2" selected="@(Model.SelectedLoaiPhieu == 2)">Phiếu Xuất Kho</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label small fw-semibold">Từ ngày</label>
                    <input type="date" name="tuNgay" class="form-control form-control-sm" value="@(Model.TuNgay?.ToString("yyyy-MM-dd"))" />
                </div>
                <div class="col-md-2 d-flex gap-2">
                    <button type="submit" class="btn btn-primary btn-sm flex-fill">
                        <i class="bi bi-filter me-1"></i>Lọc
                    </button>
                    <a asp-action="Index" class="btn btn-outline-secondary btn-sm">Đặt lại</a>
                </div>
            </form>
        </div>
    </div>

    <!-- Bảng Chứng Từ Nhập Kho -->
    @if (!Model.SelectedLoaiPhieu.HasValue || Model.SelectedLoaiPhieu.Value == 1)
    {
        <div class="card shadow-sm border-0 mb-3">
            <div class="card-header bg-white py-2 d-flex justify-content-between align-items-center">
                <h6 class="mb-0 fw-bold text-success">
                    <i class="bi bi-box-arrow-in-down me-1"></i>Danh Sách Phiếu Nhập Kho (Mẫu 01-VT)
                </h6>
                <span class="badge bg-success-subtle text-success border border-success">@Model.InwardVouchers.Count phiếu</span>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Số Phiếu</th>
                                <th>Ngày Hạch Toán</th>
                                <th>Kho Nhập</th>
                                <th>Nhà Cung Cấp</th>
                                <th>Diễn Giải</th>
                                <th class="text-end">Số Lượng</th>
                                <th class="text-end">Tổng Tiền Hàng</th>
                                <th class="text-center">Trạng Thái</th>
                                <th class="text-end">Thao Tác</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (!Model.InwardVouchers.Any())
                            {
                                <tr>
                                    <td colspan="9" class="text-center text-muted py-3">Chưa có phiếu nhập kho nào.</td>
                                </tr>
                            }
                            else
                            {
                                @foreach (var item in Model.InwardVouchers)
                                {
                                    <tr>
                                        <td class="fw-bold">@item.SoPhieu</td>
                                        <td>@item.NgayHachToan.ToString("dd/MM/yyyy")</td>
                                        <td>@item.TenKho</td>
                                        <td>@(item.TenNhaCungCap ?? "Nhập nội bộ/Khác")</td>
                                        <td><small class="text-muted">@item.DienGiai</small></td>
                                        <td class="text-end fw-semibold">@item.TongSoLuong.ToString("N2")</td>
                                        <td class="text-end fw-bold text-success">@item.TongTienHang.ToString("N0") đ</td>
                                        <td class="text-center">
                                            @if (item.TrangThai == TrangThaiPhieuKho.DaGhiSo)
                                            {
                                                <span class="badge bg-success">Đã ghi sổ</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-warning text-dark">Tạm tính</span>
                                            }
                                        </td>
                                        <td class="text-end">
                                            @if (item.TrangThai == TrangThaiPhieuKho.TamTinh)
                                            {
                                                <form asp-action="PostInward" asp-route-id="@item.Id" method="post" class="d-inline">
                                                    @Html.AntiForgeryToken()
                                                    <button type="submit" class="btn btn-sm btn-outline-success py-0 px-2" title="Ghi sổ kho và hạch toán GL">Ghi Sổ</button>
                                                </form>
                                            }
                                            else
                                            {
                                                <form asp-action="UnpostInward" asp-route-id="@item.Id" method="post" class="d-inline">
                                                    @Html.AntiForgeryToken()
                                                    <button type="submit" class="btn btn-sm btn-outline-warning py-0 px-2" title="Hủy ghi sổ kho" onclick="return confirm('Bạn có chắc muốn hủy ghi sổ phiếu nhập này?');">Hủy Sổ</button>
                                                </form>
                                            }
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }

    <!-- Bảng Chứng Từ Xuất Kho -->
    @if (!Model.SelectedLoaiPhieu.HasValue || Model.SelectedLoaiPhieu.Value == 2)
    {
        <div class="card shadow-sm border-0 mb-3">
            <div class="card-header bg-white py-2 d-flex justify-content-between align-items-center">
                <h6 class="mb-0 fw-bold text-primary">
                    <i class="bi bi-box-arrow-up-right me-1"></i>Danh Sách Phiếu Xuất Kho (Mẫu 02-VT)
                </h6>
                <span class="badge bg-primary-subtle text-primary border border-primary">@Model.OutwardVouchers.Count phiếu</span>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Số Phiếu</th>
                                <th>Ngày Hạch Toán</th>
                                <th>Kho Xuất</th>
                                <th>Khách Hàng / Bộ Phận</th>
                                <th>Diễn Giải</th>
                                <th class="text-end">Số Lượng</th>
                                <th class="text-end">Giá Vốn Xuất</th>
                                <th class="text-center">Trạng Thái</th>
                                <th class="text-end">Thao Tác</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (!Model.OutwardVouchers.Any())
                            {
                                <tr>
                                    <td colspan="9" class="text-center text-muted py-3">Chưa có phiếu xuất kho nào.</td>
                                </tr>
                            }
                            else
                            {
                                @foreach (var item in Model.OutwardVouchers)
                                {
                                    <tr>
                                        <td class="fw-bold">@item.SoPhieu</td>
                                        <td>@item.NgayHachToan.ToString("dd/MM/yyyy")</td>
                                        <td>@item.TenKho</td>
                                        <td>
                                            @if (!string.IsNullOrEmpty(item.TenKhachHang))
                                            {
                                                <div>@item.TenKhachHang</div>
                                            }
                                            @if (!string.IsNullOrEmpty(item.TenPhongBan))
                                            {
                                                <small class="badge bg-light text-secondary border">@item.TenPhongBan</small>
                                            }
                                        </td>
                                        <td><small class="text-muted">@item.DienGiai</small></td>
                                        <td class="text-end fw-semibold">@item.TongSoLuong.ToString("N2")</td>
                                        <td class="text-end fw-bold text-primary">@item.TongTienGiaVon.ToString("N0") đ</td>
                                        <td class="text-center">
                                            @if (item.TrangThai == TrangThaiPhieuKho.DaGhiSo)
                                            {
                                                <span class="badge bg-success">Đã ghi sổ</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-warning text-dark">Tạm tính</span>
                                            }
                                        </td>
                                        <td class="text-end">
                                            @if (item.TrangThai == TrangThaiPhieuKho.TamTinh)
                                            {
                                                <form asp-action="PostOutward" asp-route-id="@item.Id" method="post" class="d-inline">
                                                    @Html.AntiForgeryToken()
                                                    <button type="submit" class="btn btn-sm btn-outline-primary py-0 px-2" title="Ghi sổ kho và tính giá vốn BQGQ">Ghi Sổ</button>
                                                </form>
                                            }
                                            else
                                            {
                                                <form asp-action="UnpostOutward" asp-route-id="@item.Id" method="post" class="d-inline">
                                                    @Html.AntiForgeryToken()
                                                    <button type="submit" class="btn btn-sm btn-outline-warning py-0 px-2" title="Hủy ghi sổ xuất kho" onclick="return confirm('Bạn có chắc muốn hủy ghi sổ phiếu xuất này?');">Hủy Sổ</button>
                                                </form>
                                            }
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
</div>
