@model ninjaTax.Models.ViewModels.NhanVienIndexViewModel
@using ninjaTax.Models.Entities
@{
    ViewData["Title"] = "Hồ sơ Nhân sự & Hợp đồng Lao động (HRM/Payroll)";
}

<div class="container-fluid py-3">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h3 class="mb-0 text-primary"><i class="bi bi-people-fill me-2"></i>Hồ Sơ Nhân Sự & Hợp Đồng Lao Động</h3>
            <small class="text-muted">Quản lý lương cơ bản, lương đóng BHXH (trần 46.8M NĐ 73/2024), người phụ thuộc và cam kết thuế Mẫu 08</small>
        </div>
        <div class="btn-group">
            <a asp-action="Create" class="btn btn-primary">
                <i class="bi bi-person-plus-fill me-1"></i>Thêm Mới Nhân Viên
            </a>
            <a asp-controller="ChamCong" asp-action="Index" class="btn btn-outline-info">
                <i class="bi bi-calendar-check me-1"></i>Bảng Chấm Công
            </a>
            <a asp-controller="TienLuong" asp-action="Index" class="btn btn-outline-success">
                <i class="bi bi-cash-stack me-1"></i>Bảng Tính Lương
            </a>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Summary cards -->
    <div class="row g-3 mb-4">
        <div class="col-md-3">
            <div class="card shadow-sm border-0 border-start border-primary border-4">
                <div class="card-body">
                    <div class="text-muted small text-uppercase fw-bold">Tổng số nhân sự</div>
                    <div class="fs-4 fw-bold text-primary">@Model.DanhSachNhanVien.Count người</div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card shadow-sm border-0 border-start border-success border-4">
                <div class="card-body">
                    <div class="text-muted small text-uppercase fw-bold">Đang đóng BHXH</div>
                    <div class="fs-4 fw-bold text-success">@Model.DanhSachNhanVien.Count(n => n.DongBaoHiem) người</div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card shadow-sm border-0 border-start border-warning border-4">
                <div class="card-body">
                    <div class="text-muted small text-uppercase fw-bold">HĐ Thời vụ / Thử việc</div>
                    <div class="fs-4 fw-bold text-warning">@Model.DanhSachNhanVien.Count(n => n.LoaiHopDong == LoaiHopDongLaoDong.ThuViecThoiVu) người</div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card shadow-sm border-0 border-start border-info border-4">
                <div class="card-body">
                    <div class="text-muted small text-uppercase fw-bold">Tổng quỹ lương cơ bản</div>
                    <div class="fs-4 fw-bold text-info">@Model.DanhSachNhanVien.Sum(n => n.LuongCoBan).ToString("N0") đ</div>
                </div>
            </div>
        </div>
    </div>

    <!-- Filter form -->
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-body">
            <form method="get" class="row g-3">
                <div class="col-md-4">
                    <input type="text" name="tuKhoa" value="@Model.TuKhoa" class="form-control" placeholder="Tìm theo Mã NV, Họ tên, MST, CCCD..." />
                </div>
                <div class="col-md-3">
                    <select name="phongBan" class="form-select">
                        <option value="">-- Tất cả phòng ban --</option>
                        @foreach (var pb in Model.PhongBans)
                        {
                            <option value="@pb" selected="@(Model.PhongBan == pb)">@pb</option>
                        }
                    </select>
                </div>
                <div class="col-md-3">
                    <select name="loaiHopDong" class="form-select">
                        <option value="">-- Tất cả loại hợp đồng --</option>
                        <option value="@LoaiHopDongLaoDong.HopDongDaiHan" selected="@(Model.LoaiHopDong == LoaiHopDongLaoDong.HopDongDaiHan)">Hợp đồng dài hạn (>= 3 tháng)</option>
                        <option value="@LoaiHopDongLaoDong.ThuViecThoiVu" selected="@(Model.LoaiHopDong == LoaiHopDongLaoDong.ThuViecThoiVu)">Thử việc / Thời vụ (&lt; 3 tháng)</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <button type="submit" class="btn btn-secondary w-100"><i class="bi bi-funnel me-1"></i>Lọc dữ liệu</button>
                </div>
            </form>
        </div>
    </div>

    <!-- Employees table -->
    <div class="card shadow-sm border-0">
        <div class="table-responsive">
            <table class="table table-hover table-striped align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Mã NV</th>
                        <th>Họ và Tên</th>
                        <th>Phòng ban / Chức vụ</th>
                        <th>Loại HĐ</th>
                        <th class="text-end">Lương cơ bản</th>
                        <th class="text-end">Lương đóng BH</th>
                        <th class="text-center">Người PT</th>
                        <th class="text-center">Đóng BH</th>
                        <th class="text-center">Cam kết 08</th>
                        <th class="text-center">Trạng thái</th>
                        <th class="text-center">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.DanhSachNhanVien.Any())
                    {
                        <tr>
                            <td colspan="11" class="text-center py-4 text-muted">Chưa có nhân sự nào trong danh sách.</td>
                        </tr>
                    }
                    @foreach (var nv in Model.DanhSachNhanVien)
                    {
                        <tr>
                            <td class="fw-bold">@nv.MaNhanVien</td>
                            <td>@nv.HoTen</td>
                            <td>
                                <div>@nv.PhongBan</div>
                                <small class="text-muted">@nv.ChucVu</small>
                            </td>
                            <td>
                                @if (nv.LoaiHopDong == LoaiHopDongLaoDong.HopDongDaiHan)
                                {
                                    <span class="badge bg-primary">Dài hạn</span>
                                }
                                else
                                {
                                    <span class="badge bg-warning text-dark">Thử việc/Thời vụ</span>
                                }
                            </td>
                            <td class="text-end fw-semibold">@nv.LuongCoBan.ToString("N0") đ</td>
                            <td class="text-end text-muted">@nv.LuongDongBaoHiem.ToString("N0") đ</td>
                            <td class="text-center">
                                @if (nv.SoNguoiPhuThuoc > 0)
                                {
                                    <span class="badge bg-info text-dark">@nv.SoNguoiPhuThuoc</span>
                                }
                                else
                                {
                                    <span>-</span>
                                }
                            </td>
                            <td class="text-center">
                                @if (nv.DongBaoHiem)
                                {
                                    <i class="bi bi-check-circle-fill text-success" title="Có tham gia BHXH bắt buộc"></i>
                                }
                                else
                                {
                                    <i class="bi bi-x-circle text-muted"></i>
                                }
                            </td>
                            <td class="text-center">
                                @if (nv.CoCamKet08)
                                {
                                    <span class="badge bg-success" title="Đã có cam kết Mẫu 08/CK-TNCN (miễn trừ 10%)">Có</span>
                                }
                                else
                                {
                                    <span class="text-muted">-</span>
                                }
                            </td>
                            <td class="text-center">
                                @if (nv.DangLamViec)
                                {
                                    <span class="badge bg-success">Đang làm việc</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Đã nghỉ việc</span>
                                }
                            </td>
                            <td class="text-center">
                                <a asp-action="Edit" asp-route-id="@nv.Id" class="btn btn-sm btn-outline-primary" title="Chỉnh sửa thông tin">
                                    <i class="bi bi-pencil-square"></i> Sửa
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
