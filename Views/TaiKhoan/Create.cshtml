@model ninjaTax.Models.ViewModels.TaiKhoanCreateEditViewModel
@{
    ViewData["Title"] = "Thêm Mới Tài Khoản Kế Toán";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h4 class="mb-1 text-primary"><i class="bi bi-plus-circle me-2"></i>Thêm Mới Tài Khoản Kế Toán</h4>
        <p class="text-muted small mb-0">Thiết lập tài khoản cấp mới hoặc tài khoản con trực thuộc theo chuẩn Thông tư 99/2025/TT-BTC</p>
    </div>
    <div>
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm"><i class="bi bi-arrow-left me-1"></i>Quay lại danh mục</a>
    </div>
</div>

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card shadow-sm border-0">
            <div class="card-body p-4">
                <form asp-action="Create" method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2" role="alert"></div>

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="TaiKhoanMeId" class="form-label fw-semibold"></label>
                            <select asp-for="TaiKhoanMeId" class="form-select" asp-items="ViewBag.TaiKhoanMeList">
                                <option value="">-- Tài khoản cấp 1 (Không có mẹ) --</option>
                            </select>
                            <span asp-validation-for="TaiKhoanMeId" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="MaTaiKhoan" class="form-label fw-semibold"></label>
                            <input asp-for="MaTaiKhoan" class="form-control font-monospace fw-bold" placeholder="VD: 11111, 64211..." />
                            <span asp-validation-for="MaTaiKhoan" class="text-danger small"></span>
                            <div class="form-text small">Nếu có tài khoản mẹ, mã tài khoản con bắt buộc phải bắt đầu bằng mã mẹ.</div>
                        </div>

                        <div class="col-12">
                            <label asp-for="TenTaiKhoan" class="form-label fw-semibold"></label>
                            <input asp-for="TenTaiKhoan" class="form-control" placeholder="Tên chi tiết tài khoản kế toán..." />
                            <span asp-validation-for="TenTaiKhoan" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="LoaiTaiKhoan" class="form-label fw-semibold"></label>
                            <select asp-for="LoaiTaiKhoan" class="form-select" asp-items="Html.GetEnumSelectList<ninjaTax.Models.Entities.LoaiTaiKhoan>()"></select>
                            <span asp-validation-for="LoaiTaiKhoan" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="TinhChat" class="form-label fw-semibold"></label>
                            <select asp-for="TinhChat" class="form-select" asp-items="Html.GetEnumSelectList<ninjaTax.Models.Entities.TinhChatTaiKhoan>()"></select>
                            <span asp-validation-for="TinhChat" class="text-danger small"></span>
                        </div>

                        <div class="col-12 mt-4">
                            <div class="form-check form-switch mb-2">
                                <input asp-for="DangHoatDong" class="form-check-input" />
                                <label asp-for="DangHoatDong" class="form-check-label fw-semibold">Đang kích hoạt sử dụng</label>
                            </div>
                        </div>
                    </div>

                    <div class="d-flex gap-2 mt-4 pt-3 border-top">
                        <button type="submit" class="btn btn-primary px-4"><i class="bi bi-save me-1"></i>Lưu tài khoản</button>
                        <a asp-action="Index" class="btn btn-outline-secondary px-3">Hủy</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
