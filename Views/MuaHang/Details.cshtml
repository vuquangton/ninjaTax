@model ninjaTax.Models.Entities.HoaDonMuaHang
@{
    ViewData["Title"] = $"Chi tiết Hóa đơn mua {Model.SoChungTu}";
}

<div class="container-fluid py-3">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <div class="d-flex align-items-center gap-2">
                <h3 class="mb-0 text-primary"><i class="bi bi-receipt me-2"></i>Hóa Đơn Mua Hàng: @Model.SoChungTu</h3>
                @if (Model.DaGhiSo)
                {
                    <span class="badge bg-success"><i class="bi bi-check-circle me-1"></i>Đã ghi sổ kế toán</span>
                }
                else
                {
                    <span class="badge bg-warning text-dark"><i class="bi bi-clock me-1"></i>Chưa ghi sổ</span>
                }
            </div>
            <small class="text-muted">HĐĐT số: <strong>@Model.KHMauSoHoaDon@Model.KyHieuHoaDon - @Model.SoHoaDon</strong> | Ngày HĐ: @Model.NgayHoaDon.ToString("dd/MM/yyyy")</small>
        </div>
        <div class="d-flex gap-2">
            @if (!Model.DaGhiSo)
            {
                <form asp-action="GhiSo" asp-route-id="@Model.Id" method="post">
                    <button type="submit" class="btn btn-success">
                        <i class="bi bi-journal-arrow-down me-1"></i>Ghi Sổ Kế Toán (TT99)
                    </button>
                </form>
            }
            else
            {
                <form asp-action="BoGhiSo" asp-route-id="@Model.Id" method="post">
                    <button type="submit" class="btn btn-outline-warning">
                        <i class="bi bi-journal-x me-1"></i>Bỏ Ghi Sổ
                    </button>
                </form>
                @if (Model.ButToanId.HasValue)
                {
                    <a asp-controller="ButToan" asp-action="Details" asp-route-id="@Model.ButToanId.Value" class="btn btn-outline-primary">
                        <i class="bi bi-box-arrow-up-right me-1"></i>Xem Bút Toán Sổ Cái
                    </a>
                }
            }
            <a asp-action="Index" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left me-1"></i>Danh sách
            </a>
        </div>
    </div>

    @if (TempData["ThongBaoThanhCong"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>@TempData["ThongBaoThanhCong"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["ThongBaoLoi"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["ThongBaoLoi"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Header information -->
    <div class="row g-3 mb-4">
        <div class="col-md-8">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-header bg-light fw-bold text-dark">
                    <i class="bi bi-building me-1"></i>Thông tin Nhà cung cấp & Chứng từ gốc
                </div>
                <div class="card-body">
                    <div class="row g-2">
                        <div class="col-sm-4 text-muted">Nhà cung cấp:</div>
                        <div class="col-sm-8 fw-semibold">@Model.NhaCungCap?.TenDoiTuong</div>

                        <div class="col-sm-4 text-muted">Mã số thuế:</div>
                        <div class="col-sm-8 font-monospace">@Model.NhaCungCap?.MaSoThue</div>

                        <div class="col-sm-4 text-muted">Địa chỉ:</div>
                        <div class="col-sm-8">@Model.NhaCungCap?.DiaChi</div>

                        <div class="col-sm-4 text-muted">Diễn giải:</div>
                        <div class="col-sm-8">@Model.DienGiai</div>

                        <div class="col-sm-4 text-muted">Hạn thanh toán:</div>
                        <div class="col-sm-8">@Model.HanThanhToan.ToString("dd/MM/yyyy")</div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-header bg-light fw-bold text-dark">
                    <i class="bi bi-calculator me-1"></i>Tổng hợp giá trị hóa đơn
                </div>
                <div class="card-body">
                    <div class="d-flex justify-content-between mb-2">
                        <span class="text-muted">Tiền hàng:</span>
                        <span class="font-monospace fw-bold">@Model.TongTienHang.ToString("N0") đ</span>
                    </div>
                    <div class="d-flex justify-content-between mb-2">
                        <span class="text-muted">Chiết khấu:</span>
                        <span class="font-monospace text-danger">-@Model.TongTienChietKhau.ToString("N0") đ</span>
                    </div>
                    <div class="d-flex justify-content-between mb-2">
                        <span class="text-muted">Thuế GTGT (1331):</span>
                        <span class="font-monospace text-primary">+@Model.TongTienThue.ToString("N0") đ</span>
                    </div>
                    <hr />
                    <div class="d-flex justify-content-between mb-2">
                        <span class="fw-bold">Tổng thanh toán:</span>
                        <span class="font-monospace fw-bold text-success fs-5">@Model.TongThanhToan.ToString("N0") đ</span>
                    </div>
                    <div class="d-flex justify-content-between">
                        <span class="text-muted">Còn phải trả (331):</span>
                        <span class="font-monospace fw-bold text-danger">@Model.ConPhaiTra.ToString("N0") đ</span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Items table -->
    <div class="card shadow-sm border-0">
        <div class="card-header bg-light fw-bold text-dark">
            <i class="bi bi-list-ul me-1"></i>Danh sách mặt hàng & Hạch toán chi tiết
        </div>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-3" style="width: 40px;">#</th>
                        <th>Mặt hàng</th>
                        <th class="text-end">Số lượng</th>
                        <th class="text-end">Đơn giá</th>
                        <th class="text-end">Thành tiền</th>
                        <th class="text-end">CK</th>
                        <th class="text-end">VAT</th>
                        <th class="text-end">Tiền thuế</th>
                        <th class="text-center">TK Nợ</th>
                        <th class="text-center">TK Có</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var c in Model.ChiTietHangs)
                    {
                        <tr>
                            <td class="ps-3">@c.DongSo</td>
                            <td>
                                <div class="fw-bold">@c.VatTuHangHoa?.TenVatTu</div>
                                <small class="text-muted font-monospace">@c.VatTuHangHoa?.MaVatTu (@c.VatTuHangHoa?.DonViTinh)</small>
                            </td>
                            <td class="text-end font-monospace">@c.SoLuong.ToString("N2")</td>
                            <td class="text-end font-monospace">@c.DonGia.ToString("N0") đ</td>
                            <td class="text-end font-monospace fw-semibold">@c.ThanhTien.ToString("N0") đ</td>
                            <td class="text-end font-monospace">@c.TienChietKhau.ToString("N0") đ</td>
                            <td class="text-end">@c.ThueSuatVat%</td>
                            <td class="text-end font-monospace text-primary">@c.TienThueVat.ToString("N0") đ</td>
                            <td class="text-center"><span class="badge bg-secondary font-monospace">@c.TaiKhoanNo?.MaTaiKhoan</span></td>
                            <td class="text-center"><span class="badge bg-secondary font-monospace">@c.TaiKhoanCo?.MaTaiKhoan</span></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
