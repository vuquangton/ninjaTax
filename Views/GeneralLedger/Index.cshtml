@model ninjaTax.Models.ViewModels.SoNhatKyChungViewModel
@{
    ViewData["Title"] = "Sổ Nhật Ký Chung (S03a-DN)";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h4 class="mb-1"><i class="bi bi-journal-bookmark me-2 text-primary"></i>Sổ Nhật Ký Chung (Mẫu S03a-DN)</h4>
        <p class="text-muted small mb-0">Theo Thông tư số 99/2025/TT-BTC của Bộ Tài chính</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="SoCai" class="btn btn-outline-secondary btn-sm"><i class="bi bi-book me-1"></i>Xem Sổ Cái</a>
        <a asp-action="BangCanDoi" class="btn btn-outline-primary btn-sm"><i class="bi bi-layout-three-columns me-1"></i>Bảng Cân Đối TK</a>
        <button class="btn btn-outline-success btn-sm" onclick="window.print()"><i class="bi bi-printer me-1"></i>In Sổ S03a</button>
    </div>
</div>

<div class="card mb-3 shadow-sm border-0">
    <div class="card-body py-2">
        <form method="get" class="row g-2 align-items-center">
            <div class="col-auto">
                <label class="form-label small mb-0 fw-semibold">Từ ngày:</label>
                <input type="date" name="tuNgay" class="form-control form-control-sm" value="@Model.TuNgay.ToString("yyyy-MM-dd")" />
            </div>
            <div class="col-auto">
                <label class="form-label small mb-0 fw-semibold">Đến ngày:</label>
                <input type="date" name="denNgay" class="form-control form-control-sm" value="@Model.DenNgay.ToString("yyyy-MM-dd")" />
            </div>
            <div class="col-auto align-self-end">
                <button type="submit" class="btn btn-primary btn-sm px-3"><i class="bi bi-search me-1"></i>Tra cứu</button>
            </div>
        </form>
    </div>
</div>

<div class="row g-3 mb-3">
    <div class="col-md-6">
        <div class="card border-0 bg-light shadow-sm">
            <div class="card-body py-2">
                <small class="text-muted">Tổng số dòng phát sinh</small>
                <h5 class="mb-0 text-dark fw-bold">@Model.TongSoDong.ToString("N0") <span class="fs-6 fw-normal text-muted">dòng</span></h5>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card border-0 bg-light shadow-sm">
            <div class="card-body py-2">
                <small class="text-muted">Tổng số tiền phát sinh trong kỳ</small>
                <h5 class="mb-0 text-primary fw-bold">@Model.TongPhatSinh.ToString("N0") <span class="fs-6 fw-normal text-muted">VNĐ</span></h5>
            </div>
        </div>
    </div>
</div>

<div class="card shadow-sm border-0">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover table-striped align-middle mb-0 text-nowrap">
                <thead class="table-light">
                    <tr>
                        <th>Ngày HT</th>
                        <th>Ngày CT</th>
                        <th>Số CT</th>
                        <th>Diễn giải</th>
                        <th class="text-center">TK Nợ</th>
                        <th class="text-center">TK Có</th>
                        <th class="text-end">Số tiền (VNĐ)</th>
                        <th>Đối tượng</th>
                        <th>Phòng ban</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.DongChiTiets.Count == 0)
                    {
                        <tr>
                            <td colspan="9" class="text-center py-4 text-muted">
                                <i class="bi bi-inbox fs-2 d-block mb-1"></i>
                                Không có phát sinh nào trong kỳ kế toán đã chọn.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var item in Model.DongChiTiets)
                        {
                            <tr>
                                <td>@item.NgayHachToan.ToString("dd/MM/yyyy")</td>
                                <td>@item.NgayChungTu.ToString("dd/MM/yyyy")</td>
                                <td><span class="badge bg-secondary-subtle text-secondary font-monospace">@item.SoChungTu</span></td>
                                <td>@item.DienGiai</td>
                                <td class="text-center fw-bold text-primary">@item.MaTaiKhoanNo</td>
                                <td class="text-center fw-bold text-success">@item.MaTaiKhoanCo</td>
                                <td class="text-end fw-semibold">@item.SoTien.ToString("N0")</td>
                                <td><small class="text-muted">@item.DoiTuong</small></td>
                                <td><small class="badge bg-light text-dark">@item.PhongBan</small></td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
