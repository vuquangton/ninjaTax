@model ninjaTax.Models.ViewModels.VatTuHangHoaIndexViewModel
@{
    ViewData["Title"] = "Danh mục Vật tư & Hàng hóa";
}

<div class="container-fluid py-3">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h3 class="mb-0 text-primary"><i class="bi bi-box-seam me-2"></i>Danh mục Vật tư & Hàng hóa</h3>
            <small class="text-muted">Quản lý mã hàng, đơn giá, định danh tài khoản ngầm định theo Thông tư 99/2025/TT-BTC</small>
        </div>
        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-circle me-1"></i>Thêm Mặt Hàng Mới
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Search & Filter Card -->
    <div class="card shadow-sm border-0 mb-3">
        <div class="card-body">
            <form method="get" class="row g-2 align-items-center">
                <div class="col-md-5">
                    <div class="input-group">
                        <span class="input-group-text bg-white"><i class="bi bi-search"></i></span>
                        <input type="text" name="timKiem" value="@Model.TimKiem" class="form-control" placeholder="Tìm theo Mã hoặc Tên vật tư hàng hóa..." />
                    </div>
                </div>
                <div class="col-md-3">
                    <select name="loai" class="form-select">
                        <option value="">-- Tất cả tính chất --</option>
                        <option value="1" selected="@(Model.LoaiFilter == ninjaTax.Models.Entities.LoaiVatTuHangHoa.VatTu)">Nguyên vật liệu (152)</option>
                        <option value="2" selected="@(Model.LoaiFilter == ninjaTax.Models.Entities.LoaiVatTuHangHoa.CongCuDungCu)">Công cụ dụng cụ (153)</option>
                        <option value="3" selected="@(Model.LoaiFilter == ninjaTax.Models.Entities.LoaiVatTuHangHoa.ThanhPham)">Thành phẩm (155)</option>
                        <option value="4" selected="@(Model.LoaiFilter == ninjaTax.Models.Entities.LoaiVatTuHangHoa.HangHoa)">Hàng hóa (156)</option>
                        <option value="5" selected="@(Model.LoaiFilter == ninjaTax.Models.Entities.LoaiVatTuHangHoa.DichVu)">Dịch vụ (642/154)</option>
                    </select>
                </div>
                <div class="col-md-4 d-flex gap-2">
                    <button type="submit" class="btn btn-secondary">
                        <i class="bi bi-funnel me-1"></i>Lọc
                    </button>
                    <a asp-action="Index" class="btn btn-outline-secondary">Đặt lại</a>
                </div>
            </form>
        </div>
    </div>

    <div class="card shadow-sm border-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-3">Mã hàng</th>
                        <th>Tên hàng hóa / dịch vụ</th>
                        <th>Loại</th>
                        <th>ĐVT</th>
                        <th>TK Kho / DT / GV</th>
                        <th class="text-end">Thuế VAT</th>
                        <th class="text-end">Giá mua gần nhất</th>
                        <th class="text-end">Giá bán tiêu chuẩn</th>
                        <th class="text-center">Trạng thái</th>
                        <th class="text-end pe-3">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.DanhSachVatTu.Any())
                    {
                        <tr>
                            <td colspan="10" class="text-center py-4 text-muted">
                                <i class="bi bi-inbox fs-3 d-block mb-2"></i>Không tìm thấy vật tư hàng hóa nào.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var item in Model.DanhSachVatTu)
                        {
                            <tr>
                                <td class="ps-3 font-monospace fw-bold text-primary">@item.MaVatTu</td>
                                <td>
                                    <div class="fw-semibold">@item.TenVatTu</div>
                                </td>
                                <td>
                                    @switch (item.LoaiVatTu)
                                    {
                                        case ninjaTax.Models.Entities.LoaiVatTuHangHoa.HangHoa:
                                            <span class="badge bg-primary">Hàng hóa (156)</span>
                                            break;
                                        case ninjaTax.Models.Entities.LoaiVatTuHangHoa.VatTu:
                                            <span class="badge bg-secondary">Nguyên vật liệu (152)</span>
                                            break;
                                        case ninjaTax.Models.Entities.LoaiVatTuHangHoa.DichVu:
                                            <span class="badge bg-info text-dark">Dịch vụ (642)</span>
                                            break;
                                        case ninjaTax.Models.Entities.LoaiVatTuHangHoa.CongCuDungCu:
                                            <span class="badge bg-warning text-dark">CCDC (153)</span>
                                            break;
                                        case ninjaTax.Models.Entities.LoaiVatTuHangHoa.ThanhPham:
                                            <span class="badge bg-success">Thành phẩm (155)</span>
                                            break;
                                        default:
                                            <span class="badge bg-light text-dark">Khác</span>
                                            break;
                                    }
                                </td>
                                <td>@item.DonViTinh</td>
                                <td>
                                    <small class="font-monospace text-muted">
                                        Kho: @(item.TaiKhoanKhoMa ?? "-") | DT: @(item.TaiKhoanDoanhThuMa ?? "-") | GV: @(item.TaiKhoanGiaVonMa ?? "-")
                                    </small>
                                </td>
                                <td class="text-end">@(item.ThueSuatVatMacDinh)%</td>
                                <td class="text-end font-monospace">@item.DonGiaMuaGanNhat.ToString("N0") đ</td>
                                <td class="text-end font-monospace text-success fw-bold">@item.DonGiaBanTieuChuan.ToString("N0") đ</td>
                                <td class="text-center">
                                    @if (item.DangHoatDong)
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success-subtle">Đang dùng</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger-subtle text-danger border border-danger-subtle">Ngừng</span>
                                    }
                                </td>
                                <td class="text-end pe-3">
                                    <div class="btn-group btn-group-sm">
                                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-outline-info" title="Chi tiết">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-outline-secondary" title="Sửa">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        @if (!item.DaPhatSinhGiaoDich)
                                        {
                                            <button type="button" class="btn btn-outline-danger" title="Xóa"
                                                    onclick="xacNhanXoa(@item.Id, '@item.MaVatTu')">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<form id="deleteForm" method="post" asp-action="Delete">
    @Html.AntiForgeryToken()
</form>

@section Scripts {
<script>
    function xacNhanXoa(id, ma) {
        if (confirm(`Bạn có chắc chắn muốn xóa mặt hàng [${ma}] không?`)) {
            const form = document.getElementById('deleteForm');
            form.action = '@Url.Action("Delete", "VatTuHangHoa")/' + id;
            form.submit();
        }
    }
</script>
}
