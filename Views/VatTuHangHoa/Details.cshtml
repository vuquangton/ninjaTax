@model ninjaTax.Models.ViewModels.VatTuHangHoaItemViewModel
@{
    ViewData["Title"] = $"Chi tiết mặt hàng: {Model.MaVatTu}";
}

<div class="container-fluid py-3">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div class="d-flex align-items-center">
            <a asp-action="Index" class="btn btn-outline-secondary me-3">
                <i class="bi bi-arrow-left"></i> Quay lại
            </a>
            <div>
                <h3 class="mb-0 text-primary"><i class="bi bi-box-seam me-2"></i>@Model.TenVatTu</h3>
                <span class="font-monospace text-muted">Mã SKU: @Model.MaVatTu</span>
            </div>
        </div>
        <div class="btn-group">
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">
                <i class="bi bi-pencil me-1"></i>Chỉnh sửa thông tin
            </a>
        </div>
    </div>

    <div class="row g-3">
        <div class="col-lg-6">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-header bg-light fw-bold py-2">
                    <i class="bi bi-info-circle me-1"></i>Đặc tính kỹ thuật & Phân loại
                </div>
                <div class="card-body">
                    <table class="table table-sm table-borderless">
                        <tbody>
                            <tr>
                                <th style="width: 40%;" class="text-muted">Tính chất:</th>
                                <td>
                                    @switch (Model.LoaiVatTu)
                                    {
                                        case ninjaTax.Models.Entities.LoaiVatTuHangHoa.HangHoa:
                                            <span class="badge bg-primary">Hàng hóa (156)</span>
                                            break;
                                        case ninjaTax.Models.Entities.LoaiVatTuHangHoa.VatTu:
                                            <span class="badge bg-secondary">Nguyên vật liệu (152)</span>
                                            break;
                                        case ninjaTax.Models.Entities.LoaiVatTuHangHoa.DichVu:
                                            <span class="badge bg-info text-dark">Dịch vụ (642)</span>
                                            break;
                                        case ninjaTax.Models.Entities.LoaiVatTuHangHoa.CongCuDungCu:
                                            <span class="badge bg-warning text-dark">CCDC (153)</span>
                                            break;
                                        case ninjaTax.Models.Entities.LoaiVatTuHangHoa.ThanhPham:
                                            <span class="badge bg-success">Thành phẩm (155)</span>
                                            break;
                                        default:
                                            <span class="badge bg-light text-dark">Khác</span>
                                            break;
                                    }
                                </td>
                            </tr>
                            <tr>
                                <th class="text-muted">Đơn vị tính:</th>
                                <td class="fw-semibold">@Model.DonViTinh</td>
                            </tr>
                            <tr>
                                <th class="text-muted">Theo dõi tồn kho:</th>
                                <td>
                                    @if (Model.DangTheoDoiTonKho)
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success-subtle">Có theo dõi</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">Không theo dõi</span>
                                    }
                                </td>
                            </tr>
                            <tr>
                                <th class="text-muted">Thuế suất VAT mặc định:</th>
                                <td class="fw-bold font-monospace">@Model.ThueSuatVatMacDinh %</td>
                            </tr>
                            <tr>
                                <th class="text-muted">Giá mua gần nhất:</th>
                                <td class="font-monospace">@Model.DonGiaMuaGanNhat.ToString("N0") VNĐ</td>
                            </tr>
                            <tr>
                                <th class="text-muted">Giá bán tiêu chuẩn:</th>
                                <td class="font-monospace text-success fw-bold">@Model.DonGiaBanTieuChuan.ToString("N0") VNĐ</td>
                            </tr>
                            <tr>
                                <th class="text-muted">Trạng thái:</th>
                                <td>
                                    @if (Model.DangHoatDong)
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success-subtle">Đang sử dụng</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger-subtle text-danger border border-danger-subtle">Ngừng sử dụng</span>
                                    }
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <div class="col-lg-6">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-header bg-light fw-bold py-2">
                    <i class="bi bi-journal-bookmark me-1"></i>Định khoản Kế toán TT99/2025/TT-BTC
                </div>
                <div class="card-body">
                    <table class="table table-sm table-borderless">
                        <tbody>
                            <tr>
                                <th style="width: 45%;" class="text-muted">Tài khoản Kho ngầm định:</th>
                                <td class="font-monospace fw-bold text-primary">@(Model.TaiKhoanKhoMa ?? "Chưa thiết lập")</td>
                            </tr>
                            <tr>
                                <th class="text-muted">Tài khoản Doanh thu:</th>
                                <td class="font-monospace fw-bold text-success">@(Model.TaiKhoanDoanhThuMa ?? "Chưa thiết lập")</td>
                            </tr>
                            <tr>
                                <th class="text-muted">Tài khoản Giá vốn:</th>
                                <td class="font-monospace fw-bold text-danger">@(Model.TaiKhoanGiaVonMa ?? "Chưa thiết lập")</td>
                            </tr>
                        </tbody>
                    </table>

                    <hr />

                    <div class="mb-3">
                        <span class="text-muted d-block mb-1">Ràng buộc dữ liệu phát sinh:</span>
                        @if (Model.DaPhatSinhGiaoDich)
                        {
                            <span class="badge bg-warning text-dark"><i class="bi bi-lock-fill me-1"></i>Đã có chứng từ phát sinh kho / hóa đơn</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">Chưa phát sinh chứng từ</span>
                        }
                    </div>

                    <div class="d-flex gap-2">
                        <a asp-controller="Inventory" asp-action="BaoCaoNhapXuatTon" class="btn btn-sm btn-outline-primary">
                            <i class="bi bi-table me-1"></i>Xem Sổ NXT (S10-DN)
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
