@model ButToanIndexViewModel
@{
    ViewData["Title"] = "Sổ Nhật Ký Chung - Chứng Từ Nghiệp Vụ Khác";
}

<div class="container-fluid py-3">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h2 class="h3 mb-0 text-gray-800">Sổ Nhật Ký Chung (Chứng Từ Nghiệp Vụ)</h2>
            <small class="text-muted">Tuân thủ chế độ kế toán Thông tư TT99 - VAS (Không sử dụng TK 911)</small>
        </div>
        <div>
            <a asp-action="Create" class="btn btn-primary" data-action="create">
                <i class="bi bi-plus-circle"></i> + Lập Chứng Từ Mới
                <small class="shortcut-hint ms-1">(F2)</small>
            </a>
        </div>
    </div>

    @if (TempData["ThongBaoThanhCong"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["ThongBaoThanhCong"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["ThongBaoLoi"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["ThongBaoLoi"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Thống kê tổng hợp -->
    <div class="row mb-4">
        <div class="col-md-6">
            <div class="card border-left-primary shadow h-100 py-2">
                <div class="card-body">
                    <div class="text-xs font-weight-bold text-primary text-uppercase mb-1">Tổng Số Chứng Từ</div>
                    <div class="h5 mb-0 font-weight-bold text-gray-800">@Model.TongSoChungTu chứng từ</div>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card border-left-success shadow h-100 py-2">
                <div class="card-body">
                    <div class="text-xs font-weight-bold text-success text-uppercase mb-1">Tổng Tiền Phát Sinh (VNĐ)</div>
                    <div class="h5 mb-0 font-weight-bold text-gray-800">@Model.TongPhatSinh.ToString("N0") VNĐ</div>
                </div>
            </div>
        </div>
    </div>

    <!-- Bảng danh sách chứng từ -->
    <div class="card shadow mb-4">
        <div class="card-header py-3">
            <h6 class="m-0 font-weight-bold text-primary">Danh Sách Bút Toán</h6>
        </div>
        <div class="card-body p-0">
            <div id="gridButToanContainer" class="p-3">
                @{
                    ViewData["GridId"] = "gridButToan";
                    ViewData["DataUrl"] = Url.Action("ListJson", "ButToan");
                    ViewData["ColumnDefsJson"] = "[{\"field\":\"soChungTu\",\"headerName\":\"Số CT\",\"pinned\":\"left\",\"width\":140,\"cellRenderer\":function(p){return '<a href=\"/ButToan/Details/'+p.data.id+'\" class=\"fw-bold text-primary\">'+p.value+'</a>';}},{\"field\":\"ngayHachToan\",\"headerName\":\"Ngày Hạch Toán\",\"type\":\"ntDate\",\"width\":150},{\"field\":\"dienGiai\",\"headerName\":\"Diễn Giải\",\"flex\":1,\"minWidth\":200},{\"field\":\"tongTien\",\"headerName\":\"Tổng Tiền\",\"type\":\"ntCurrency\",\"width\":180},{\"field\":\"trangThaiText\",\"headerName\":\"Trạng Thái\",\"type\":\"ntStatus\",\"width\":140},{\"headerName\":\"Thao Tác\",\"width\":120,\"pinned\":\"right\",\"cellRenderer\":function(p){return '<a href=\"/ButToan/Details/'+p.data.id+'\" class=\"btn btn-sm btn-outline-info py-0 px-2\">Xem</a>';}}]";
                }
                @await Html.PartialAsync("_AgGrid")
            </div>
        </div>
    </div>
</div>
