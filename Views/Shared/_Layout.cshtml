<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ninjaTax</title>
    <script type="importmap"></script>
    <!-- Google Fonts — Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" />
    <!-- Bootstrap & Icons -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <!-- ninjaTax design system (must come after Bootstrap to override) -->
    <link rel="stylesheet" href="~/css/ninjatax-theme.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/ninjaTax.styles.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="nt-app">
    <header>
        @await Component.InvokeAsync("NavMenu")
    </header>

    <!-- Toast notification container -->
    <div id="nt-toast-container" class="toast-container position-fixed top-0 end-0 p-3" style="z-index:9998;"></div>

    <!-- Keyboard shortcut help overlay -->
    <div id="nt-shortcut-help" role="dialog" aria-modal="true" aria-label="Phím tắt">
        <div class="nt-shortcut-panel">
            <h5><i class="bi bi-keyboard me-2"></i>Phím tắt</h5>
            <table>
                <tbody>
                    <tr><td><kbd>F2</kbd></td><td>Thêm mới</td></tr>
                    <tr><td><kbd>Ctrl</kbd>+<kbd>S</kbd></td><td>Lưu nháp</td></tr>
                    <tr><td><kbd>F9</kbd></td><td>Ghi sổ / Duyệt</td></tr>
                    <tr><td><kbd>Esc</kbd></td><td>Hủy / Đóng</td></tr>
                    <tr><td><kbd>Enter</kbd></td><td>Chuyển ô tiếp theo</td></tr>
                    <tr><td><kbd>Tab</kbd></td><td>Chuyển ô kế tiếp</td></tr>
                    <tr><td><kbd>?</kbd></td><td>Mở/đóng bảng phím tắt</td></tr>
                </tbody>
            </table>
            <div class="mt-3 text-end">
                <button type="button" class="btn btn-sm btn-outline-secondary" onclick="document.getElementById('nt-shortcut-help').classList.remove('is-visible')">
                    Đóng <kbd>Esc</kbd>
                </button>
            </div>
        </div>
    </div>

    <div class="container-fluid px-4">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted mt-4">
        <div class="container py-2">
            <small>&copy; 2026 ninjaTax &mdash; Phần mềm kế toán TT99 &mdash;
                <a asp-area="" asp-controller="Home" asp-action="Privacy">Chính sách</a>
            </small>
        </div>
    </footer>

    <!-- Core scripts -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <!-- ninjaTax JS modules (loaded in dependency order) -->
    <script src="~/js/ninjatax-locale.js" asp-append-version="true"></script>
    <script src="~/js/ninjatax-search.js" asp-append-version="true"></script>
    <script src="~/js/ninjatax-keys.js" asp-append-version="true"></script>
    <script src="~/js/ninjatax-workflow.js" asp-append-version="true"></script>
    <script src="~/js/ninjatax-toast.js" asp-append-version="true"></script>
    <script src="~/js/ninjatax-validation.js" asp-append-version="true"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
