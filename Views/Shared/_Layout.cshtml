<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ninjaTax</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/ninjaTax.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark bg-dark border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand fw-bold text-warning" asp-area="" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-shield-check me-1"></i>ninjaTax <span class="badge bg-warning text-dark fs-6">TT99</span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-lg-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Home" asp-action="Index"><i class="bi bi-speedometer2 me-1"></i>Dashboard</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="MuaHang" asp-action="Index"><i class="bi bi-cart-check me-1"></i>Mua Hàng (Đầu Vào)</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="BanHang" asp-action="Index"><i class="bi bi-receipt-cutoff me-1"></i>Bán Hàng (HĐĐT NĐ123)</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="CongNo" asp-action="Index"><i class="bi bi-wallet2 me-1"></i>Công Nợ (AR/AP)</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="ThuTien" asp-action="Index"><i class="bi bi-cash me-1"></i>Thu Tiền (111/112)</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="ChiTien" asp-action="Index"><i class="bi bi-credit-card me-1"></i>Chi Tiền (UNC)</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="TaiSan" asp-action="Index"><i class="bi bi-box me-1"></i>TSCĐ & CCDC</a>
                        </li>
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" id="payrollDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                <i class="bi bi-people me-1"></i>Tiền Lương & Thuế
                            </a>
                            <ul class="dropdown-menu" aria-labelledby="payrollDropdown">
                                <li><a class="dropdown-item" asp-controller="NhanVien" asp-action="Index"><i class="bi bi-person-lines-fill me-2"></i>Hồ sơ nhân sự</a></li>
                                <li><a class="dropdown-item" asp-controller="ChamCong" asp-action="Index"><i class="bi bi-calendar-check me-2"></i>Bảng chấm công</a></li>
                                <li><hr class="dropdown-divider"></li>
                                <li><a class="dropdown-item" asp-controller="TienLuong" asp-action="Index"><i class="bi bi-cash-coin me-2"></i>Bảng tính lương</a></li>
                            </ul>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="ThuTien" asp-action="SoQuy"><i class="bi bi-book me-1"></i>Sổ Quỹ</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="ButToan" asp-action="Index"><i class="bi bi-journal-text me-1"></i>Sổ Nhật Ký Chung</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="VatTuHangHoa" asp-action="Index"><i class="bi bi-box-seam me-1"></i>Hàng Hóa</a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container-fluid px-4">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - ninjaTax - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
